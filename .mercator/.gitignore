# CONTROL_ROOT ignores — everything a BOUND control plane produces at runtime.
#
# Dev-tooling artifacts are NOT here: their subject is
# Mercator's own source, so they live with the rest of the dev tooling in the
# framework repository's root .gitignore, outside this shipped directory
# (META.md §18.4, §25, I-028).

# Local Claude Code settings
CLAUDE.local.md
.claude/settings.local.json

# Runtime logs
.agent/runs/*
!.agent/runs/.gitkeep
.agent/tmp/*
!.agent/tmp/.gitkeep
.agent/cache/
.agent/state/tool_audit.jsonl
.agent/state/control_runs.jsonl

# Lean ビルド成果物(just build が lean/.lake/build から生成し bin/ へ配置する)
/bin/mercator
/lean/.lake/
